# URL de la instancia de Odoo con base_tms_energy instalado
ODOO_URL=http://localhost:8069
# Base de datos (opcional, solo si Odoo tiene varias)
ODOO_DB=
# Debe coincidir con el parámetro de sistema tms.portal_api_key en Odoo (opcional)
ODOO_PORTAL_API_KEY=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres): openssl rand -base64 48
SESSION_SECRET=
# Fuerza la cookie "secure" (por defecto true en producción). Ponlo a false si sirves por http
COOKIE_SECURE=
